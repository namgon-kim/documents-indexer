# Loopback-only browser login for local development.
INDEXER_DEV_AUTH=1
DATA_DIR=data

# Enable after confirming your documents and queries can be processed externally.
ALLOW_EXTERNAL_PROCESSING=0
# 파서와 임베딩 서비스 연결 설정
PARSER_PROVIDER=upstage
PARSER_BASE_URL=https://api.upstage.ai/v1
PARSER_API_KEY=
PARSER_MODEL=document-parse-260930
PARSER_MODE=enhanced
PARSER_OPTIONS=
EMBEDDING_BASE_URL=https://api.upstage.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_PROFILE=solar-2-v1
EMBEDDING_DOCUMENT_MODEL=solar-embedding-2-passage
EMBEDDING_QUERY_MODEL=solar-embedding-2-query
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_INPUT_BYTES=3800
EMBEDDING_BATCH_SIZE=24
RERANKER_PROVIDER=disabled
RERANKER_BASE_URL=https://api.cohere.com/v2
RERANKER_API_KEY=
RERANKER_MODEL=rerank-v3.5
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6.1-terra
LLM_MODELS=

# Blank uses Qdrant embedded local storage under DATA_DIR.
# Set an address for a separate Qdrant server and a key only if it requires one.
QDRANT_URL=
QDRANT_API_KEY=

MAX_UPLOAD_BYTES=52428800
DEFAULT_TARGET_CHARS=1000
DEFAULT_OVERLAP_CHARS=150
DEFAULT_OCR_POLICY=automatic
DEFAULT_DPI=
MAX_PAGES=2000
MAX_RETRY_PAGES=200
PARSER_SYNC_TIMEOUT_SECONDS=900
REMOTE_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=900

# For HTTPS deployments, set the public origin and a strong access key.
PUBLIC_ORIGIN=
INDEXER_ACCESS_KEY=
# Space-separated exact HTTPS origins of hosts allowed to embed the UI.
ALLOWED_FRAME_ANCESTORS=
EMBED_SIGNING_SECRET=

# Override only if you serve a web build from another path.
# WEB_DIR=apps/web/dist
