# Public HTTPS origin (scheme + hostname, no path). Set an access key before starting.
PUBLIC_ORIGIN=https://indexer.example.com
# Path prefix when a proxy serves the app under a path (e.g. /ai/labs/project/app). Blank serves at /.
PUBLIC_BASE_PATH=
INDEXER_ACCESS_KEY=
ALLOWED_FRAME_ANCESTORS=
EMBED_SIGNING_SECRET=

# The existing Qdrant container publishes port 6333 on this host.
# Change this address if the existing service is elsewhere.
QDRANT_URL=http://host.docker.internal:6333
QDRANT_API_KEY=

ALLOW_EXTERNAL_PROCESSING=1
PARSER_PROVIDER=upstage
PARSER_BASE_URL=https://api.upstage.ai/v1
PARSER_API_KEY=
PARSER_MODEL=document-parse-260930
PARSER_MODE=enhanced
PARSER_OPTIONS=
PARSER_SYNC_TIMEOUT_SECONDS=900
EMBEDDING_BASE_URL=https://api.upstage.ai/v1
EMBEDDING_API_KEY=
EMBEDDING_PROFILE=solar-2-v1
EMBEDDING_DOCUMENT_MODEL=solar-embedding-2-passage
EMBEDDING_QUERY_MODEL=solar-embedding-2-query
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_INPUT_BYTES=3800
EMBEDDING_BATCH_SIZE=24
RERANKER_PROVIDER=disabled
RERANKER_BASE_URL=https://api.cohere.com/v2
RERANKER_API_KEY=
RERANKER_MODEL=rerank-v3.5
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6.1-terra
LLM_MODELS=
MAX_UPLOAD_BYTES=52428800
MAX_PAGES=2000
MAX_RETRY_PAGES=200
REMOTE_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=900
DEFAULT_TARGET_CHARS=1000
DEFAULT_OVERLAP_CHARS=150
DEFAULT_OCR_POLICY=automatic
DEFAULT_DPI=

INDEXER_UID=1000
INDEXER_GID=1000
INDEXER_STATE_DIR=./data/production
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8000
